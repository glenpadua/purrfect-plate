#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running pre-commit checks..."

# Run type check
echo "Checking TypeScript types..."
pnpm run build

# Run linting (if you have it)
if pnpm run lint > /dev/null 2>&1; then
  echo "Running ESLint..."
  pnpm run lint
fi

echo "Pre-commit checks passed!"
