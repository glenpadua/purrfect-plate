# Convex
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-project-name.convex.cloud

# Optional server-only extraction prototype services. Never use NEXT_PUBLIC_ here.
SUPADATA_API_KEY=
OPENAI_API_KEY=
RECIPE_EXTRACTION_MODEL=gpt-4.1-mini
# Set automatically by node scripts/setup-extraction-worker.mjs
# EXTRACTION_PYTHON=/absolute/path/to/project/.venv-extraction/bin/python
