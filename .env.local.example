# Convex
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-project-name.convex.cloud
# Required by pnpm build; Metro uses apps/mobile/.env.local instead.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Required only for the retained Next /api/recipes authentication endpoints.
CLERK_SECRET_KEY=

# Optional server-only extraction prototype services. Never use NEXT_PUBLIC_ here.
SUPADATA_API_KEY=
OPENAI_API_KEY=
RECIPE_EXTRACTION_MODEL=gpt-4.1-mini
# Set automatically by node scripts/setup-extraction-worker.mjs
# EXTRACTION_PYTHON=/absolute/path/to/project/.venv-extraction/bin/python

# Local durable recipe imports (server-only)
CONVEX_URL=https://basic-poodle-462.convex.cloud
# Must match the development Convex deployment's worker secret.
IMPORT_WORKER_SECRET=
MEDIA_WORKER_URL=
MEDIA_WORKER_SECRET=
# Clerk issuer is configured on the Convex deployment; use the existing project value.
# Local frontend variables live in apps/mobile/.env.local, not this file.
