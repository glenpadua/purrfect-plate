{
  "name": "purrfect-plate",
  "version": "0.1.0",
  "description": "A cozy cat-themed recipe picker built with Next.js, Convex, and shadcn/ui.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "cheerio>undici": "7.29.1",
      "react-native": "0.86.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "node scripts/build-product-web.mjs && next build",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:extraction:live": "node scripts/test-extraction-prototype.mjs",
    "test:coverage": "vitest run --coverage",
    "convex:configure": "convex dev --configure",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "mobile": "pnpm --filter @purrfect-plate/mobile start",
    "mobile:ios": "pnpm --filter @purrfect-plate/mobile ios",
    "mobile:typecheck": "pnpm --filter @purrfect-plate/mobile typecheck",
    "import:worker": "node --env-file=.env.local --import tsx scripts/dev-import-worker.ts",
    "design:tokens": "node scripts/sync-design-tokens.mjs",
    "product:web": "pnpm --filter @purrfect-plate/mobile start --web --localhost --port 8082"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@clerk/nextjs": "^7.9.2",
    "@clerk/ui": "^1.32.3",
    "@hookform/resolvers": "^5.1.1",
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@remixicon/react": "^4.9.0",
    "@tabler/icons-react": "^3.37.1",
    "browser-image-compression": "^2.0.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "framer-motion": "^12.23.24",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.60.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "convex-test": "^0.0.58",
    "jsdom": "^28.1.0",
    "postcss": "8.5.28",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
