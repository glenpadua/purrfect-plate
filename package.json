{
  "name": "purrfect-plate",
  "version": "0.1.0",
  "description": "One Expo application for web and mobile, with Convex and a server-only import gateway.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "cheerio>undici": "7.29.1",
      "react-native": "0.86.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "dev": "pnpm product:web",
    "build": "node scripts/build-product-web.mjs && next build",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:extraction:live": "node scripts/test-extraction-prototype.mjs",
    "test:coverage": "vitest run --coverage",
    "convex:configure": "convex dev --configure",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "mobile": "pnpm --filter @purrfect-plate/mobile start",
    "mobile:ios": "pnpm --filter @purrfect-plate/mobile ios",
    "mobile:typecheck": "pnpm --filter @purrfect-plate/mobile typecheck",
    "import:worker": "node --env-file=.env.local --import tsx scripts/dev-import-worker.ts",
    "product:web": "pnpm --filter @purrfect-plate/mobile start --web --localhost --port 8082",
    "server:dev": "next dev --webpack",
    "test:mobile": "pnpm --filter @purrfect-plate/mobile test --runInBand",
    "typecheck": "next typegen && tsc --noEmit && pnpm mobile:typecheck"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.2",
    "cheerio": "^1.2.0",
    "convex": "^1.45.0",
    "ipaddr.js": "^2.5.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "convex-test": "^0.0.58",
    "tsx": "^4.23.13",
    "typescript": "5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
